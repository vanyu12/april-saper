# Токен от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес, по которому открывается Mini App (без слэша в конце)
# Пример: https://saper.example.com
PUBLIC_URL=

# Где слушать HTTP
HOST=0.0.0.0
PORT=8080

# База данных
# Если DATABASE_URL задан — используется Postgres (например, Neon), иначе SQLite.
DATABASE_URL=
DB_PATH=data/saper.db

# Режим разработки: пускает в API без Telegram initData (только для локальных тестов!)
DEV_MODE=0
DEV_USER_ID=0

CHAT_URL=
